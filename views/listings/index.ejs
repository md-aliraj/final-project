
<% layout("/layouts/boilerplate") %>
<style>
  #filters {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    align-items: center;
    justify-content: space-evenly;
    background: rgba(255, 255, 255, 0.25) !important; 
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 50px;
    padding: 0.8rem 2rem;
    margin: 1.5rem auto 1rem auto;
    width: 95%;
  }

  #filters::-webkit-scrollbar { display: none; }

  .filter {
    text-align: center;
    margin: 0 1.2rem;
    opacity: 0.85;
    transition: 0.3s;
    color: white;
    min-width: 95px;
  }

  .filter a {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column; 
    align-items: center;
  }

  .filter i {
    font-size: 1.6rem !important;
    margin-bottom: 5px;
  }

  .filter p {
    font-size: 0.9rem !important;
    margin: 0;
    font-weight: 500;
  }

  .tax-toggle-box {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .tax-toggle {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 20px;
    padding: 0.6rem 1.5rem;
    color: white;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
  }

  .tax-info {
    display: none;
    color: #FF385C; 
    font-weight: bold;
    font-style: normal;
  }
</style>

<div id="filters">
  <% const categories = [
    { name: "Trending", icon: "fa-fire" },
    { name: "Rooms", icon: "fa-bed" },
    { name: "Iconic Cities", icon: "fa-mountain-city" },
    { name: "Mountains", icon: "fa-mountain" },
    { name: "Castles", icon: "fa-fort-awesome", brand: true },
    { name: "Amazing Pools", icon: "fa-person-swimming" },
    { name: "Camping", icon: "fa-campground" },
    { name: "Farms", icon: "fa-cow" },
    { name: "Arctic", icon: "fa-snowflake" },
    { name: "Domes", icon: "fa-igloo" },
    { name: "Boats", icon: "fa-ship" }
  ]; %>

  <% for(let cat of categories) { %>
    <div class="filter" id="filter-<%= cat.name.replace(/\s+/g, '-') %>">
      <a href="/listings/search?category=<%= cat.name %>">
        <div><i class="<%= cat.brand ? 'fa-brands' : 'fa-solid' %> <%= cat.icon %>"></i></div>
        <p><%= cat.name %></p>
      </a>
    </div>
  <% } %>
</div>

<div class="tax-toggle-box">
  <div class="tax-toggle">
    <div class="form-check-reverse form-switch">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault" style="cursor:pointer;">Display total after taxes</label>
    </div>
  </div>
</div>

<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
  <% for(let listing of allListings) { %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;" />
        <div class="card-body">
          <p class="card-text" style="padding-left: 10px;">
            <b><%= listing.title %></b> <br>
            &#8377; <%= listing.price.toLocaleString("en-IN")%> / night
            <span class="tax-info"> &nbsp; &nbsp;+18% GST</span>
          </p>
        </div>
      </div>
    </a>
  <% } %>
</div>

<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  
  taxSwitch.addEventListener("change", () => {
    let taxInfos = document.getElementsByClassName("tax-info");
    for (let info of taxInfos) {
      if (taxSwitch.checked) {
        info.style.display = "inline";
      } else {
        info.style.display = "none";
      }
    }
  });

 
  document.addEventListener("DOMContentLoaded", () => {
    let urlParams = new URLSearchParams(window.location.search);
    let category = urlParams.get("category");
    if (category) {
      document.querySelectorAll(".filter").forEach((filter) => {
        if (filter.querySelector("p").innerText.trim() === category) {
          filter.classList.add("active-filter");
        }
      });
    }
  });
</script>